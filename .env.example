# Sentra DCIM environment configuration.
# Copy to .env and fill in values:  cp .env.example .env && chmod 600 .env
# NEVER commit .env. Generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- Application ---
APP_ENV=production
APP_LOG_LEVEL=info
APP_HTTP_ADDR=:8080
APP_SHUTDOWN_TIMEOUT=15s
APP_DISPLAY_TZ=Asia/Makassar

# --- PostgreSQL / TimescaleDB ---
POSTGRES_DB=sentra
POSTGRES_USER=sentra
POSTGRES_PASSWORD=CHANGE_ME
# Host port (bound to 127.0.0.1 only)
POSTGRES_HOST_PORT=5432

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME
REDIS_HOST_PORT=6379

# --- Caddy (reverse proxy) ---
# Bound to 127.0.0.1 until a domain and TLS are decided (DECISIONS D-008, D-013).
CADDY_HTTP_BIND=127.0.0.1:8080
CADDY_SITE_ADDRESS=:80

# --- Backup ---
BACKUP_DIR=/var/backups/sentra
BACKUP_RETENTION_DAYS=14
# Optional offsite command; receives the backup directory path as $1 (Pending, D-009)
BACKUP_OFFSITE_CMD=
