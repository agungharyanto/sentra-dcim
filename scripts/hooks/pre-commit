#!/usr/bin/env bash
# Pre-commit hook: block commits containing secrets.
# Install with: make hooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed; refusing to commit (see docs/DEPENDENCIES.md)." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
