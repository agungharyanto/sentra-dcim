# Sentra DCIM — installed by `make fail2ban-web` (scripts/fail2ban-web-install.sh). Do not edit on the server.
# HOST_RE, LOGPATH and IGNOREIP placeholders are filled by the installer. Since v0.3.3: failed APP sign-ins (password
# or MFA code) per client IP (D-066); the basic_auth filter of ISS-026 is gone.

[sentra-web]
enabled   = true
filter    = sentra-app-login[sentra_host="@HOST_RE@"]
# Caddy access log on the caddy_logs volume (resolved with `docker volume inspect` at install time).
logpath   = @LOGPATH@
backend   = polling
# 10 failed sign-ins (password or MFA code) from one IP within 10 minutes → 1 h ban, growing up to 24 h. Per
# account the app locks after 5 (15 min); this stops one IP from cycling through many accounts.
maxretry  = 10
findtime  = 10m
bantime   = 1h
bantime.increment = true
bantime.maxtime   = 24h
# Exempt: localhost and ADMIN_IPS from .env (validated by the installer), so admins cannot be banned by typos.
ignoreip  = @IGNOREIP@
# Published ports are DNAT'ed to the caddy container, so traffic goes through FORWARD → DOCKER-USER, not INPUT.
# REJECT (icmp-port-unreachable) so clients fail fast. IPv4 only: no IPv6 is published (see runbook fail2ban.md).
banaction = iptables-multiport
# actionstart_on_demand=false: create the chain and the DOCKER-USER jump when the jail starts (verifiable, and
# re-created on every fail2ban restart — e.g. after Docker restarts, see the systemd drop-in).
action    = iptables-multiport[name=sentra-web, chain=DOCKER-USER, port="80,443", protocol=tcp, blocktype="REJECT --reject-with icmp-port-unreachable", actionstart_on_demand=false]
