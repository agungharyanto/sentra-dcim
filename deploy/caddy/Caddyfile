{
	admin 127.0.0.1:2019
	# ACME account email for Let's Encrypt expiry/problem notices (from .env, never committed).
	email {$ACME_EMAIL}
	skip_install_trust
	servers {
		# HTTP/3 (UDP 443) disabled: only 80/tcp and 443/tcp are opened in the firewall.
		protocols h1 h2
	}
	# Caddy is the edge proxy: no trusted_proxies, so client-supplied X-Forwarded-For is never trusted.
	log {
		output stdout
		format json
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-Via
	}
	# Kept out of the block above: header deletions make that block deferred (applied at write time), which would
	# overwrite the UI's own CSP. Set immediately here so (web_static) can replace it.
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
}

# Static SPA from the web image (web/Dockerfile → /srv/web). script-src stays 'self' (no inline/eval scripts).
# style-src: a per-request nonce instead of 'unsafe-inline' (ISS-030, D-065). The same {http.request.uuid} goes into
# the CSP header and, via templates, into <meta name="csp-nonce"> of index.html; the UI hands it to
# react-style-singleton (Radix scroll lock), the only runtime <style> injector left. index.html is therefore
# dynamic: no-store and no ETag/Last-Modified, or a revalidated copy would carry an old nonce. Hashed assets are
# immutable.
(web_static) {
	# route keeps the written order (plain directives are re-sorted by Caddy).
	route {
		root * /srv/web
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-{http.request.uuid}'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			Cache-Control "no-cache"
		}
		@assets {
			path /assets/*
			file
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Deep links (/anything) fall back to index.html; missing hashed assets stay 404 (never cached as HTML).
		@spa {
			not path /assets/*
			not file
		}
		rewrite @spa /index.html
		@html path / /index.html
		header @html {
			Cache-Control "no-store"
			-ETag
			-Last-Modified
		}
		templates @html
		file_server
	}
}

(app_proxy) {
	reverse_proxy {args[0]} {
		# The app derives client IP (rate limiting, audit) from X-Real-IP; never trust client-supplied values.
		header_up X-Real-IP {client_ip}
		header_up -True-Client-IP
		header_down -Server
		header_down -Via
		# Caddy already set the edge CSP; drop the app's copy so responses carry exactly one policy.
		header_down -Content-Security-Policy
		health_uri /api/v1/health
		health_interval 15s
	}
}

# Public site. Certificates are obtained automatically from Let's Encrypt (HTTP-01 / TLS-ALPN-01) and
# plain HTTP is redirected to HTTPS. Without DOMAIN (dev/CI) Caddy serves localhost with its internal CA.
{$DOMAIN:localhost} {
	import security_headers
	encode zstd gzip
	# Access log to stdout (docker logs) ...
	log
	# ... and to a rotated file for fail2ban (jail sentra-web: failed app logins/MFA codes, D-066). The file holds client IPs: kept at most 30 days
	# (roll_keep_for), ~220 MB max. Authorization values are always logged as "REDACTED" (never log_credentials).
	log access_file {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	request_body {
		max_size 1MB
	}

	# Access model since v0.3.3 (basic_auth removed, ISS-026, D-066): the SPA (index.html + hashed assets) is public so
	# the login page loads; every data endpoint below requires an app session that passed MFA (default-deny in the
	# app, ADR-003). Only health and the short version are public; other API paths are rejected at the proxy.
	@public {
		method GET HEAD
		path /api/v1/health /api/v1/version
	}
	handle @public {
		# Public app listener: /api/v1/version returns only {"version"}.
		import app_proxy app:8080
	}

	# UI bootstrap document and Help Center API (pages, images, OpenAPI): session required by the app.
	@bootstrap {
		method GET HEAD
		path /api/v1/ui/bootstrap /api/v1/help/*
	}
	handle @bootstrap {
		import app_proxy app:8080
	}

	# Session auth API: login is the only call without a session; the MFA steps need a pending session. Failed
	# logins/codes (401 from the app) feed the fail2ban jail sentra-web (D-066).
	@auth {
		method GET HEAD POST DELETE
		path /api/v1/auth/*
	}
	handle @auth {
		import app_proxy app:8080
	}

	# User administration: session + permission checked by the app (users.read/users.manage/roles.read).
	@users {
		method GET HEAD POST PUT PATCH
		path /api/v1/users /api/v1/users/* /api/v1/roles
	}
	handle @users {
		import app_proxy app:8080
	}

	handle /api/* {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":{"code":"forbidden","message":"not publicly available"}}` 403
	}

	# Web UI (SPA): public code without data; the app shows the login page until a session exists.
	handle {
		import web_static
	}

	# Errors raised by handlers (file_server 404/405) bypass the deferred header block above;
	# re-apply the security headers and answer with the standard JSON error envelope.
	handle_errors {
		import security_headers
		map {err.status_code} {err_code} {
			404 not_found
			405 method_not_allowed
			default error
		}
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":{"code":"{err_code}","message":"{err.status_text}"}}` {err.status_code}
	}
}

# Explicit HTTP→HTTPS redirect (instead of Caddy's automatic one) so the Server header is hidden here too.
# ACME HTTP-01 challenges on port 80 are still answered by Caddy before these routes.
http://{$DOMAIN:localhost} {
	header -Server
	redir https://{host}{uri} 308
}

# Internal listener, published on host 127.0.0.1:8080 only: full API for ops scripts and smoke tests.
http://:8081 {
	import security_headers

	handle /api/* {
		# Internal app listener: full details (e.g. /api/v1/version build + clock). Never route publicly.
		import app_proxy app:8081
	}
	handle {
		respond "Sentra DCIM (internal)" 200
	}
}
