{
	admin 127.0.0.1:2019
	# ACME account email for Let's Encrypt expiry/problem notices (from .env, never committed).
	email {$ACME_EMAIL}
	skip_install_trust
	servers {
		# HTTP/3 (UDP 443) disabled: only 80/tcp and 443/tcp are opened in the firewall.
		protocols h1 h2
	}
	# Caddy is the edge proxy: no trusted_proxies, so client-supplied X-Forwarded-For is never trusted.
	log {
		output stdout
		format json
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-Via
	}
	# Kept out of the block above: header deletions make that block deferred (applied at write time), which would
	# overwrite the UI's own CSP. Set immediately here so (web_static) can replace it.
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
}

# Temporary gate for the web UI and /api/v1/ui/bootstrap until Auth (v0.3) — MUST be removed then (ISS-026, D-043).
# Credentials come from .env (WEB_BASIC_AUTH_USER / WEB_BASIC_AUTH_HASH, bcrypt from `caddy hash-password`).
# Without them docker-compose.yml supplies a lockout hash of a discarded random string: every login fails.
(web_auth) {
	basic_auth {
		{$WEB_BASIC_AUTH_USER} {$WEB_BASIC_AUTH_HASH}
	}
}

# Static SPA from the web image (web/Dockerfile → /srv/web). Strict CSP without 'unsafe-inline' (Vite emits no
# inline scripts or styles); hashed assets are immutable, everything else — index.html above all — is revalidated.
(web_static) {
	# route keeps the written order (plain directives are re-sorted by Caddy).
	route {
		root * /srv/web
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			Cache-Control "no-cache"
		}
		@assets {
			path /assets/*
			file
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Deep links (/anything) fall back to index.html; missing hashed assets stay 404 (never cached as HTML).
		@spa {
			not path /assets/*
			not file
		}
		rewrite @spa /index.html
		file_server
	}
}

(app_proxy) {
	reverse_proxy {args[0]} {
		# The app derives client IP (rate limiting, audit) from X-Real-IP; never trust client-supplied values.
		header_up X-Real-IP {client_ip}
		header_up -True-Client-IP
		header_down -Server
		header_down -Via
		health_uri /api/v1/health
		health_interval 15s
	}
}

# Public site. Certificates are obtained automatically from Let's Encrypt (HTTP-01 / TLS-ALPN-01) and
# plain HTTP is redirected to HTTPS. Without DOMAIN (dev/CI) Caddy serves localhost with its internal CA.
{$DOMAIN:localhost} {
	import security_headers
	encode zstd gzip
	log

	request_body {
		max_size 1MB
	}

	# Until Auth (v0.3) only these endpoints are public; other API paths are rejected at the proxy.
	@public {
		method GET HEAD
		path /api/v1/health /api/v1/version
	}
	handle @public {
		# Public app listener: /api/v1/version returns only {"version"}.
		import app_proxy app:8080
	}

	# UI bootstrap document behind the temporary basic_auth (ISS-026).
	@bootstrap {
		method GET HEAD
		path /api/v1/ui/bootstrap
	}
	handle @bootstrap {
		import web_auth
		import app_proxy app:8080
	}

	handle /api/* {
		header Content-Type "application/json; charset=utf-8"
		respond `{"error":{"code":"forbidden","message":"not publicly available"}}` 403
	}

	# Web UI (SPA) behind the temporary basic_auth (ISS-026).
	handle {
		import web_auth
		import web_static
	}
}

# Explicit HTTP→HTTPS redirect (instead of Caddy's automatic one) so the Server header is hidden here too.
# ACME HTTP-01 challenges on port 80 are still answered by Caddy before these routes.
http://{$DOMAIN:localhost} {
	header -Server
	redir https://{host}{uri} 308
}

# Internal listener, published on host 127.0.0.1:8080 only: full API for ops scripts and smoke tests.
http://:8081 {
	import security_headers

	handle /api/* {
		# Internal app listener: full details (e.g. /api/v1/version build + clock). Never route publicly.
		import app_proxy app:8081
	}
	handle {
		respond "Sentra DCIM (internal)" 200
	}
}
